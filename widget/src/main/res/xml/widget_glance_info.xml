<?xml version="1.0" encoding="utf-8"?>
<!--
  «At a glance» (PLANNING.md §7). The two cards share one size spec on purpose, so they
  sit side by side and trade places on a home screen: the same default placement (four cells
  by one, the size Chiaro's pair opens at), the same minimum (one cell: minResizeWidth and
  minResizeHeight, 40 dp by the platform's 70 × n − 30), and no maximum. A maximum in dp
  cannot mean "four cells": Launcher3 turns it into cells on every grid profile it supports and
  keeps the smallest answer, so a value that allows four cells on a portrait grid refuses them
  where landscape cells are wide, and one that never refuses them is not a cap. Every layout
  has a form for any grant instead (docs/adr/0005-widgets.md).

  updatePeriodMillis is 0: the tracking service pushes every repaint (WidgetUpdateCoordinator),
  and there is no second clock for the battery to pay. The configure activity is optional, so
  a card is placed at once with its defaults; a long press opens it.

  previewLayout is what the picker shows before the launcher asks for a generated preview (API
  35+, GlanceAppWidget.providePreview): a static drawing of the default card.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.callbackdev.passo.widget.config.WidgetConfigActivity"
    android:description="@string/widget_glance_desc"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/widget_glance_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
