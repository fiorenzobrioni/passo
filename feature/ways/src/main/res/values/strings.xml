    <string name="ways_title">Ways</string>
    <string name="ways_back">Back</string>
    <string name="ways_intro">Walk a pilgrim way from wherever you are: the distance you walk each day carries you along it, stage by stage. No location, only your steps.</string>
    <string name="ways_group_ways">The ways</string>
    <string name="ways_group_yours">Your ways</string>
    <string name="ways_under_way">Under way</string>
