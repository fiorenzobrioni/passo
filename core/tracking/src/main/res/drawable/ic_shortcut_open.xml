<?xml version="1.0" encoding="utf-8"?>
<!-- A launcher shortcut's mark for an open outing (Phase 21): its icon in white over the launcher
     icon's ground (ic_shortcut_ground, written by tools/draw_launcher_icon.py), as an adaptive
     icon, as the Outing shortcut's is (ic_shortcut_outing.xml). The glyph is the themed layer too,
     read by its alpha. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_shortcut_ground" />
    <foreground android:drawable="@drawable/ic_shortcut_open_foreground" />
    <monochrome android:drawable="@drawable/ic_shortcut_open_foreground" />
</adaptive-icon>
