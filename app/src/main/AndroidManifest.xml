<?xml version="1.0" encoding="utf-8"?>
<!--
  Passo's permissions are the short list in PLANNING.md §10, and they arrive with the phase
  that needs them (tracking in Phase 1). Never here, from this file or from any library:
  INTERNET, location, exact alarms, battery-optimization exemptions, high-rate or body
  sensors. `checkForbiddenPermissions` fails the build on the merged manifest if one appears.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".PassoApplication"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Passo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Passo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
